{
  "name": "distributed-wagering-processor", "version": "1.0.0", "private": true,
  "scripts": {
    "start": "bun src/main.ts", "dev": "bun --watch src/main.ts",
    "typecheck": "tsc --noEmit", "test": "bun test test/unit.test.ts",
    "test:integration": "bun test --timeout 120000 test/integration.test.ts",
    "migration:run": "bun src/infrastructure/migrate.ts up",
    "migration:revert": "bun src/infrastructure/migrate.ts down",
    "queues:init": "bun scripts/queues.ts", "demo": "bun scripts/demo.ts"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.0.0", "@nestjs/common": "^11.0.0", "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0", "pg": "^8.13.0", "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.0", "typeorm": "^0.3.28", "prom-client": "^15.1.3"
  },
  "devDependencies": { "@types/bun": "^1.3.0", "@types/express": "^5.0.0", "typescript": "^5.9.0" }
}
